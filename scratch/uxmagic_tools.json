  {
    "name": "edit_design",
    "title": "Edit design (find/replace)",
    "description": "Targeted find/replace on a frame’s screen HTML. Replaces only the FIRST occurrence of `find`. Call read_screen first and copy the exact substring — a single-character mismatch errors. A new artifact version is always created. For the replacement: STRICT: (1) NEVER use a style= attribute. (2) No <style> tag/block. (3) No arbitrary colors (no bg-[#xxx]). (4) Style only via class= with Tailwind + theme classes (bg-background, text-primary, font-heading, shadow-md, etc.) so Style Guide changes apply live. Inner body HTML only — no <html>/<head>/<body> tags.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "frameId": {
          "type": "string",
          "description": "Frame id from list_frames."
        },
        "find": {
          "type": "string",
          "description": "Exact substring to find, copied verbatim from read_screen."
        },
        "replace": {
          "type": "string",
          "description": "Replacement markup. STRICT: (1) NEVER use a style= attribute. (2) No <style> tag/block. (3) No arbitrary colors (no bg-[#xxx]). (4) Style only via class= with Tailwind + theme classes (bg-background, text-primary, font-heading, shadow-md, etc.) so Style Guide changes apply live. Inner body HTML only — no <html>/<head>/<body> tags."
        },
        "versionId": {
          "type": "string",
          "description": "Optional artifact version to edit; defaults to the active version."
        }
      },
      "required": [
        "frameId",
        "find",
        "replace"
      ],
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": false,
      "idempotentHint": false,
      "openWorldHint": false
    },
    "execution": {
      "taskSupport": "forbidden"
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "frameId": {
          "type": "string"
        },
        "newVersionId": {
          "type": "string"
        }
      },
      "required": [
        "frameId",
        "newVersionId"
      ],
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    }
  },
  {
    "name": "update_design",
    "title": "Update design (full body)",
    "description": "Replace the ENTIRE body of a frame with new markup, creating a new artifact version. Use for broad redesigns/rewrites, not small edits (use edit_design). STRICT: (1) NEVER use a style= attribute. (2) No <style> tag/block. (3) No arbitrary colors (no bg-[#xxx]). (4) Style only via class= with Tailwind + theme classes (bg-background, text-primary, font-heading, shadow-md, etc.) so Style Guide changes apply live. Inner body HTML only — no <html>/<head>/<body> tags.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "frameId": {
          "type": "string",
          "description": "Frame id to update."
        },
        "screen_html": {
          "type": "string",
          "description": "New inner body HTML. STRICT: (1) NEVER use a style= attribute. (2) No <style> tag/block. (3) No arbitrary colors (no bg-[#xxx]). (4) Style only via class= with Tailwind + theme classes (bg-background, text-primary, font-heading, shadow-md, etc.) so Style Guide changes apply live. Inner body HTML only — no <html>/<head>/<body> tags."
        }
      },
      "required": [
        "frameId",
        "screen_html"
      ],
      "additionalProperties": false,
