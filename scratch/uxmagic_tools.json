  },
  {
    "name": "confirm_generation",
    "title": "Confirm generation (human-in-the-loop)",
    "description": "Approve or reject a pending decision when generation_status reports pendingApproval (e.g. the agent proposed a set of screens to create). Pass the pendingApproval.toolCallId and approved=true/false. Optionally edit payload (e.g. the screen list) or give feedback on rejection.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "taskId": {
          "type": "string",
          "description": "The taskId returned by generate_design."
        },
        "approved": {
          "type": "boolean",
          "description": "true to approve, false to reject."
        },
        "toolCallId": {
          "type": "string",
          "description": "The pendingApproval.toolCallId from generation_status."
        },
        "payload": {
          "type": "object",
          "additionalProperties": {},
          "description": "Optional edited payload (e.g. an adjusted screen list)."
        },
        "feedback": {
          "type": "string",
          "description": "Optional note, e.g. why a proposal was rejected."
        }
      },
      "required": [
        "taskId",
        "approved"
      ],
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "annotations": {
      "readOnlyHint": false,
      "openWorldHint": false
    },
    "execution": {
      "taskSupport": "forbidden"
    }
  }
]