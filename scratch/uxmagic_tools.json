  {
    "name": "generate_design",
    "title": "Generate design (AI agent)",
    "description": "Start the UX Magic AI design agent to create or modify screens from a natural-language prompt. This is long-running and costs credits. Returns a taskId immediately — then poll generation_status with that taskId (and the returned nextCursor) until done is true. Use cancel_generation to stop it. OMIT projectId to design a NEW product: a fresh project is created and its projectId + projectUrl come back in the result. Pass projectId ONLY to add to or change an existing project (list_projects shows them); optionally frameId to focus on one screen. Never reuse a projectId from an earlier, unrelated brief.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "prompt": {
          "type": "string",
          "description": "What to design or change, in natural language."
        },
        "projectId": {
          "type": "string",
          "description": "Existing project to generate into. Omit for a new product — a project is created automatically."
        },
        "frameId": {
          "type": "string",
          "description": "Optional frame to focus on / edit."
        },
        "model": {
          "type": "string",
          "enum": [
            "design-faster",
            "design-better"
          ],
          "description": "Agent model mode (default design-faster)."
        },
        "documentIds": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Project document ids to use as context."
        },
        "autoApprove": {
          "type": "boolean",
          "description": "Default true: the agent approves its own screen plan and runs to completion. Set false only if you will watch generation_status for pendingApproval and answer it with confirm_generation — otherwise the run stalls and expires."
        }
      },
      "required": [
        "prompt"
      ],
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "annotations": {
      "readOnlyHint": false,
      "openWorldHint": true
    },
    "execution": {
      "taskSupport": "forbidden"
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "taskId": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "availableCredits": {
          "type": "number"
        },
        "projectId": {
          "type": "string"
        },
        "projectUrl": {
          "type": "string"
        },
        "createdProject": {
          "type": "boolean"
        }
      },
      "required": [
        "taskId",
        "status",
        "availableCredits",
        "projectId",
        "projectUrl",
        "createdProject"
      ],
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    }
  },
  {
    "name": "generation_status",
    "title": "Generation status",
    "description": "Poll a running generation (from generate_design). Returns the new events since `cursor` (assistant text, actions taken, credits, completion). Keep calling with the returned nextCursor until `done` is true. If pendingApproval is present the agent is waiting for a decision (HITL).",
    "inputSchema": {
      "type": "object",
      "properties": {
        "taskId": {
          "type": "string",
          "description": "The taskId returned by generate_design."
        },
        "cursor": {
          "type": "number",
          "description": "Event cursor from the previous poll (default 0)."
        }
      },
      "required": [
        "taskId"
      ],
      "additionalProperties": false,
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "annotations": {
      "readOnlyHint": true,
      "openWorldHint": false
    },
    "execution": {
      "taskSupport": "forbidden"
    }
  },
